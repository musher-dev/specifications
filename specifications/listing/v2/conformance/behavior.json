[
  {
    "id": "rendering-escapes-code",
    "suite": "rendering",
    "operation": "render",
    "requirements": [],
    "input": {
      "markdown": "`<script>alert(1)</script>`"
    },
    "expect": {
      "/html": "<p><code>&lt;script&gt;alert(1)&lt;/script&gt;</code></p>\n"
    }
  },
  {
    "id": "rendering-full-media-path",
    "suite": "rendering",
    "operation": "render",
    "requirements": [
      "LIST-MEDIA-003"
    ],
    "input": {
      "markdown": "![Overview](media/mobile/overview.png)",
      "media": {
        "media/mobile/overview.png": "https://assets.invalid/item/media/mobile/overview.png"
      }
    },
    "expect": {
      "/html": "<p><img src=\"https://assets.invalid/item/media/mobile/overview.png\" alt=\"Overview\" /></p>\n"
    }
  },
  {
