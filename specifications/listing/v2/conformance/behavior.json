  {
    "id": "publication-rejects-an-unknown-licence",
    "suite": "resolution",
    "operation": "validate",
    "requirements": [
      "LIST-LICENSE-002"
    ],
    "input": {
      "specVersion": "v2",
      "kind": "LISTING",
      "metadata": {
        "slug": "postgres"
      },
      "spec": {
        "itemType": "COMPONENT",
        "displayName": "PostgreSQL",
        "summary": "The open-source relational database",
        "category": "DATABASES",
        "lifecycleStage": "STABLE",
        "license": "MTI"
      }
    },
    "context": {
      "validationScope": "publication",
      "licenseList": {
        "licenses": [
          "Apache-2.0",
          "GPL-2.0-only",
          "MIT",
          "PostgreSQL"
        ],
        "exceptions": [
          "Classpath-exception-2.0",
          "LLVM-exception"
        ]
      }
    },
    "expect": {
      "/status": "INVALID",
      "/phase": "admission"
    },
    "diagnostics": [
      {
        "code": "ERR_UNKNOWN_LICENSE",
        "path": "/spec/license",
        "phase": "admission"
      }
    ]
  },
