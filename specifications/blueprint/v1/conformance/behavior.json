  {
    "id": "resolution-authorized-config",
    "profile": "resolution",
    "operation": "resolve",
    "requirements": [
      "BP-RESOLVE-001"
    ],
    "tree": {
      "app/blueprint.yaml": "{\n  \"specVersion\": \"v1\",\n  \"kind\": \"BLUEPRINT\",\n  \"metadata\": {\n    \"slug\": \"app\",\n    \"revision\": 1\n  },\n  \"spec\": {\n    \"components\": {\n      \"web\": {\n        \"componentRef\": \"./web.yaml\",\n        \"size\": \"general.standard.small\",\n        \"bindings\": {\n          \"url\": {\n            \"type\": \"CONFIG_REF\",\n            \"source\": \"${{ config.llm.baseUrl }}\"\n          }\n        }\n      }\n    },\n    \"parameters\": {}\n  }\n}\n",
      "app/web.yaml": "{\n  \"specVersion\": \"v1\",\n  \"kind\": \"COMPONENT\",\n  \"metadata\": {\n    \"revision\": 1\n  },\n  \"spec\": {\n    \"workload\": {\n      \"type\": \"WORKER\",\n      \"source\": {\n        \"type\": \"IMAGE\",\n        \"ref\": \"example/worker:1\"\n      }\n    },\n    \"contract\": {\n      \"inputs\": {\n        \"url\": {\n          \"description\": \"Synthetic fixture input\",\n          \"schema\": {\n            \"type\": \"string\"\n          },\n          \"target\": {\n            \"envVarKey\": \"VALUE\"\n          }\n        }\n      },\n      \"outputs\": {\n        \"forward\": {\n          \"description\": \"Synthetic fixture output\",\n          \"schema\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"INPUT\",\n            \"input\": \"url\"\n          }\n        }\n      }\n    }\n  }\n}\n"
    },
    "document": "app/blueprint.yaml",
    "context": {
      "configuration": {
        "llm.baseUrl": {
          "value": "https://synthetic.invalid",
          "sensitive": true,
          "identity": "configuration-1",
          "version": "7",
          "authorized": true
        }
      }
    },
    "expect": {
      "/status": "VALID",
      "/inputs/web:in:url/sensitive": true,
      "/outputs/web:out:forward/sensitive": true,
      "/inspection/web:in:url": {
        "sensitive": true,
        "redacted": true
      }
    }
  },
