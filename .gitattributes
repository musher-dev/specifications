# Normalize line endings. Without this, checkouts on Windows drives (including
# WSL paths under /mnt/c) rewrite every file to CRLF and produce whole-file
# phantom diffs against the LF blobs stored in git.
* text=auto eol=lf

*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.ts      text diff eol=lf
*.sh      text eol=lf

*.png     binary

# These parser fixtures are *about* their bytes, so normalization would quietly
# destroy what they test. The CRLF case asserts CRLF endings are accepted; the
# `* text=auto eol=lf` rule above rewrote it to LF, and it passed while testing
# nothing. `-text` opts them out of every normalization.
specifications/core/v1/conformance/parser/013-crlf-line-endings/case.yaml -text
specifications/core/v1/conformance/parser/012-byte-order-mark/case.yaml   -text

specifications/core/v1/conformance/parser/015-reject-malformed-utf8/case.yaml -text
