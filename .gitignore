# Generated publication tree — assembled by `task site:build`, deployed by CI.
/site/

# Build output — schema bundles and the catalog, written by `task bundle`.
# Never tracked: `task check:generated` fails if git holds any. See docs/adr/0023.
/dist/
# Downloaded release assets and other tool caches.
/.cache/

# Tooling dependencies, tools/node_modules/ among them.
node_modules/

# Dev container local state
.devcontainer/.env

# Claude Code local state. The brief is AGENTS.md, and a CLAUDE.md of any kind
# would make Claude Code ignore it (docs/adr/0041). A worktree checked out under
# .claude/worktrees/ is a nested repository and must never be staged.
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
CLAUDE.local.md

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Personal lefthook overrides, auto-merged beside .config/lefthook.yml.
/.config/lefthook-local.yml

# The Vale packages `vale sync` downloads into StylesPath
# (.config/prose/vale.ini). Only this repository's own style is tracked.
/.config/prose/styles/*
!/.config/prose/styles/MusherSpecifications/

# Task runner cache
.task/
