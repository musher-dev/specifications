[
  {
    "id": "normalization-idempotent-defaults",
    "profile": "normalization",
    "operation": "normalize",
    "requirements": [
      "COMP-VAL-004"
    ],
    "input": {
      "specVersion": "v1",
      "kind": "COMPONENT",
      "metadata": {
        "revision": 1,
        "description": "Synthetic conformance fixture component."
      },
      "spec": {
        "type": "WORKER",
        "workload": {
          "source": {
            "image": "example/worker:1"
          }
        },
        "contract": {
          "inputs": {
            "value": {
              "description": "Synthetic fixture input",
              "schema": {
                "type": "string"
              },
              "target": {
                "envVarKey": "VALUE"
              }
            }
          },
          "outputs": {}
        }
      }
    },
    "expect": {
      "/idempotent": true,
      "/value/spec/contract/inputs/value/required": true,
      "/value/spec/contract/inputs/value/sensitive": false
    }
  },
  {
    "id": "publication-first-revision",
    "profile": "lifecycle",
    "operation": "revision",
    "requirements": [
      "COMP-ID-001"
    ],
    "input": {
      "revision": 1,
      "highestPublishedRevision": 0
    },
    "expect": {
      "/status": "VALID"
    }
  },
  {
    "id": "publication-revision-gap",
    "profile": "lifecycle",
    "operation": "revision",
    "requirements": [
      "COMP-ID-001"
    ],
    "input": {
      "revision": 7,
      "highestPublishedRevision": 1
    },
    "expect": {
      "/status": "VALID"
    }
  },
  {
    "id": "publication-reused-revision",
    "profile": "lifecycle",
    "operation": "revision",
    "requirements": [
      "COMP-ID-001"
    ],
    "input": {
      "revision": 1,
      "highestPublishedRevision": 1
    },
    "expect": {
      "/status": "INVALID"
    },
    "diagnostics": [
      {
        "code": "ERR_VERSION_NOT_MONOTONIC",
        "path": "/metadata/revision"
      }
    ]
  },
  {
    "id": "constant-template-constraint",
    "profile": "resolution",
    "operation": "validate",
    "requirements": [
      "COMP-VAL-005"
    ],
    "input": {
      "specVersion": "v1",
      "kind": "COMPONENT",
      "metadata": {
        "revision": 1,
        "description": "Synthetic conformance fixture component."
      },
      "spec": {
        "type": "WORKER",
        "workload": {
          "source": {
            "image": "example/worker:1"
          }
        },
        "contract": {
          "inputs": {},
          "outputs": {
            "value": {
              "description": "Synthetic output",
              "schema": {
                "type": "string",
                "minLength": 8
              },
              "from": {
                "template": "tiny"
              }
            }
          }
        }
      }
    },
    "expect": {
      "/status": "INVALID",
      "/phase": "semantic",
      "/validationProfile": "document"
    },
    "diagnostics": [
      {
        "code": "ERR_VALUE_CONSTRAINT",
        "phase": "semantic",
        "path": "/spec/contract/outputs/value/from/template"
      }
    ]
  },
  {
    "id": "constant-template-authored-secret",
    "profile": "resolution",
    "operation": "validate",
    "requirements": [
      "COMP-VAL-005"
    ],
    "input": {
      "specVersion": "v1",
      "kind": "COMPONENT",
      "metadata": {
        "revision": 1,
        "description": "Synthetic conformance fixture component."
      },
      "spec": {
        "type": "WORKER",
        "workload": {
          "source": {
            "image": "example/worker:1"
          }
        },
        "contract": {
          "inputs": {},
          "outputs": {
            "value": {
              "description": "Synthetic output",
              "schema": {
                "type": "string"
              },
              "sensitive": true,
              "from": {
                "template": "synthetic-secret"
              }
            }
          }
        }
      }
    },
    "expect": {
      "/status": "INVALID",
      "/phase": "semantic",
      "/validationProfile": "document"
    },
    "diagnostics": [
      {
        "code": "ERR_SECRET_LITERAL",
        "phase": "semantic",
        "path": "/spec/contract/outputs/value/from/template"
      }
    ]
  }
]
