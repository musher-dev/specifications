      "app/other.yaml": "{\n  \"specVersion\": \"v1\",\n  \"kind\": \"COMPONENT\",\n  \"metadata\": {\n    \"revision\": 1\n  },\n  \"spec\": {\n    \"workload\": {\n      \"type\": \"SERVICE\",\n      \"source\": {\n        \"type\": \"IMAGE\",\n        \"ref\": \"example/service:1\"\n      },\n      \"endpoints\": {\n        \"web\": {\n          \"containerPort\": 8080,\n          \"protocol\": \"HTTP\"\n        }\n      }\n    },\n    \"contract\": {\n      \"inputs\": {\n        \"url\": {\n          \"description\": \"Synthetic fixture input\",\n          \"schema\": {\n            \"type\": \"string\"\n          },\n          \"target\": {\n            \"envVarKey\": \"VALUE\"\n          }\n        }\n      },\n      \"outputs\": {\n        \"address\": {\n          \"description\": \"Synthetic fixture output\",\n          \"schema\": {\n            \"type\": \"string\"\n          },\n          \"source\": {\n            \"type\": \"ENDPOINT\",\n            \"endpoint\": \"web\",\n            \"property\": \"privateHostname\"\n          }\n        }\n      }\n    }\n  }\n}\n"
